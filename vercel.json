{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/porfolio",
      "destination": "/portfolio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/porfolio",
      "destination": "/portfolio.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio.html"
    },
    {
      "source": "/apps/ride",
      "destination": "/apps/ride/index.html"
    },
    {
      "source": "/apps/ride/:match*",
      "destination": "/apps/ride/index.html"
    },
    {
      "source": "/apps/dental",
      "destination": "/apps/dental/index.html"
    },
    {
      "source": "/apps/dental/:match*",
      "destination": "/apps/dental/index.html"
    },
    {
      "source": "/apps/bakery",
      "destination": "/apps/bakery/index.html"
    },
    {
      "source": "/apps/bakery/:match*",
      "destination": "/apps/bakery/index.html"
    },
    {
      "source": "/apps/fruit",
      "destination": "/apps/fruit/index.html"
    },
    {
      "source": "/apps/fruit/:match*",
      "destination": "/apps/fruit/index.html"
    },
    {
      "source": "/apps/flower",
      "destination": "/apps/flower/index.html"
    },
    {
      "source": "/apps/flower/:match*",
      "destination": "/apps/flower/index.html"
    },
    {
      "source": "/apps/spa",
      "destination": "/apps/spa/index.html"
    },
    {
      "source": "/apps/spa/:match*",
      "destination": "/apps/spa/index.html"
    },
    {
      "source": "/apps/fastfood",
      "destination": "/apps/fastfood/index.html"
    },
    {
      "source": "/apps/fastfood/:match*",
      "destination": "/apps/fastfood/index.html"
    },
    {
      "source": "/apps/court",
      "destination": "/apps/court/index.html"
    },
    {
      "source": "/apps/court/:match*",
      "destination": "/apps/court/index.html"
    },
    {
      "source": "/apps/pet",
      "destination": "/apps/pet/index.html"
    },
    {
      "source": "/apps/pet/:match*",
      "destination": "/apps/pet/index.html"
    },
    {
      "source": "/apps/stay",
      "destination": "/apps/stay/index.html"
    },
    {
      "source": "/apps/stay/:match*",
      "destination": "/apps/stay/index.html"
    },
    {
      "source": "/apps/laundry",
      "destination": "/apps/laundry/index.html"
    },
    {
      "source": "/apps/laundry/:match*",
      "destination": "/apps/laundry/index.html"
    },
    {
      "source": "/apps/garage",
      "destination": "/apps/garage/index.html"
    },
    {
      "source": "/apps/garage/:match*",
      "destination": "/apps/garage/index.html"
    },
    {
      "source": "/apps/kitchen",
      "destination": "/apps/kitchen/index.html"
    },
    {
      "source": "/apps/kitchen/:match*",
      "destination": "/apps/kitchen/index.html"
    },
    {
      "source": "/apps/fleet",
      "destination": "/apps/fleet/index.html"
    },
    {
      "source": "/apps/fleet/:match*",
      "destination": "/apps/fleet/index.html"
    },
    {
      "source": "/apps/b2b",
      "destination": "/apps/b2b/index.html"
    },
    {
      "source": "/apps/b2b/:match*",
      "destination": "/apps/b2b/index.html"
    },
    {
      "source": "/apps/food",
      "destination": "/apps/fastfood/index.html"
    },
    {
      "source": "/apps/food/:match*",
      "destination": "/apps/fastfood/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
