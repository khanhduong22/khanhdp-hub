{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/porfolio",
      "destination": "/portfolio",
      "permanent": false
    },
    {
      "source": "/bio",
      "destination": "/about",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/porfolio",
      "destination": "/portfolio.html"
    },
    {
      "source": "/bio",
      "destination": "/about.html"
    },
    {
      "source": "/en",
      "destination": "/en.html"
    },
    {
      "source": "/articles",
      "destination": "/articles/index.html"
    },
    {
      "source": "/articles/:slug",
      "destination": "/articles/:slug/index.html"
    },
    {
      "source": "/diagrams/winter-arc",
      "destination": "/diagrams/winter-arc.html"
    },
    {
      "source": "/apps/ride",
      "destination": "/apps/ride/index.html"
    },
    {
      "source": "/apps/ride/:match*",
      "destination": "/apps/ride/index.html"
    },
    {
      "source": "/apps/dental",
      "destination": "/apps/dental/index.html"
    },
    {
      "source": "/apps/dental/:match*",
      "destination": "/apps/dental/index.html"
    },
    {
      "source": "/apps/bakery",
      "destination": "/apps/bakery/index.html"
    },
    {
      "source": "/apps/bakery/:match*",
      "destination": "/apps/bakery/index.html"
    },
    {
      "source": "/apps/fruit",
      "destination": "/apps/fruit/index.html"
    },
    {
      "source": "/apps/fruit/:match*",
      "destination": "/apps/fruit/index.html"
    },
    {
      "source": "/apps/flower",
      "destination": "/apps/flower/index.html"
    },
    {
      "source": "/apps/flower/:match*",
      "destination": "/apps/flower/index.html"
    },
    {
      "source": "/apps/spa",
      "destination": "/apps/spa/index.html"
    },
    {
      "source": "/apps/spa/:match*",
      "destination": "/apps/spa/index.html"
    },
    {
      "source": "/apps/fastfood",
      "destination": "/apps/fastfood/index.html"
    },
    {
      "source": "/apps/fastfood/:match*",
      "destination": "/apps/fastfood/index.html"
    },
    {
      "source": "/apps/court",
      "destination": "/apps/court/index.html"
    },
    {
      "source": "/apps/court/:match*",
      "destination": "/apps/court/index.html"
    },
    {
      "source": "/apps/pet",
      "destination": "/apps/pet/index.html"
    },
    {
      "source": "/apps/pet/:match*",
      "destination": "/apps/pet/index.html"
    },
    {
      "source": "/apps/stay",
      "destination": "/apps/stay/index.html"
    },
    {
      "source": "/apps/stay/:match*",
      "destination": "/apps/stay/index.html"
    },
    {
      "source": "/apps/laundry",
      "destination": "/apps/laundry/index.html"
    },
    {
      "source": "/apps/laundry/:match*",
      "destination": "/apps/laundry/index.html"
    },
    {
      "source": "/apps/garage",
      "destination": "/apps/garage/index.html"
    },
    {
      "source": "/apps/garage/:match*",
      "destination": "/apps/garage/index.html"
    },
    {
      "source": "/apps/kitchen",
      "destination": "/apps/kitchen/index.html"
    },
    {
      "source": "/apps/kitchen/:match*",
      "destination": "/apps/kitchen/index.html"
    },
    {
      "source": "/apps/fleet",
      "destination": "/apps/fleet/index.html"
    },
    {
      "source": "/apps/fleet/:match*",
      "destination": "/apps/fleet/index.html"
    },
    {
      "source": "/apps/b2b",
      "destination": "/apps/b2b/index.html"
    },
    {
      "source": "/apps/b2b/:match*",
      "destination": "/apps/b2b/index.html"
    },
    {
      "source": "/apps/event",
      "destination": "/apps/event/index.html"
    },
    {
      "source": "/apps/event/:match*",
      "destination": "/apps/event/index.html"
    },
    {
      "source": "/apps/reels",
      "destination": "/apps/reels/index.html"
    },
    {
      "source": "/apps/reels/:match*",
      "destination": "/apps/reels/index.html"
    },
    {
      "source": "/apps/academy",
      "destination": "/apps/academy/index.html"
    },
    {
      "source": "/apps/academy/:match*",
      "destination": "/apps/academy/index.html"
    },
    {
      "source": "/apps/food",
      "destination": "/apps/fastfood/index.html"
    },
    {
      "source": "/apps/food/:match*",
      "destination": "/apps/fastfood/index.html"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)\\.min\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon.*|apple-touch-icon\\.png|icon-.*\\.png|logo\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=31536000, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/about",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/en",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/articles(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/portfolio",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/diagrams/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
